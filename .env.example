# Placeholders only. Export your own values; .env is not loaded automatically.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE?sslmode=disable
TEST_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_TEST_DATABASE?sslmode=disable
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_COOKIE_NAME=refresh_token
# false only for local HTTP demo. Default in code is true (HTTPS).
COOKIE_SECURE=false
HTTP_ADDR=:8080
# DEBUG/INFO/WARN/ERROR/FATAL; text или json. Credentials не логируются.
LOG_LEVEL=INFO
LOG_FORMAT=text
